@model SymphonyPortal.Models.Branch

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- HEADER -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="text-white mb-0">
        <i class="fa fa-plus me-2"></i>Add New Branch
    </h4>
    <a href="/Admin/Branches" class="btn btn-secondary">
        <i class="fa fa-arrow-left me-2"></i>Back
    </a>
</div>

<div class="bg-secondary rounded p-4">
    <form method="post"
          asp-action="CreateBranch"
          asp-controller="Admin">

        <!-- NAME -->
        <div class="mb-3">
            <label class="text-white mb-2">Branch Name</label>
            <input asp-for="Name"
                   class="form-control bg-dark text-white border-0"
                   placeholder="e.g. Karachi Main Branch" />
            <span asp-validation-for="Name"
                  class="text-danger"></span>
        </div>

        <!-- CITY -->
        <div class="mb-3">
            <label class="text-white mb-2">City</label>
            <input asp-for="City"
                   class="form-control bg-dark text-white border-0"
                   placeholder="e.g. Karachi" />
        </div>

        <!-- ADDRESS -->
        <div class="mb-3">
            <label class="text-white mb-2">Address</label>
            <textarea asp-for="Address"
                      class="form-control bg-dark text-white border-0"
                      rows="3"
                          placeholder="Enter full address">
            </textarea>
                <span asp-validation-for="Address"
                      class="text-danger"></span>
            </div>

            <!-- PHONE -->
            <div class="mb-3">
                <label class="text-white mb-2">Phone Number</label>
                <input asp-for="Phone"
                       class="form-control bg-dark text-white border-0"
                       placeholder="e.g. 021-XXXXXXXX" />
                <span asp-validation-for="Phone"
                      class="text-danger"></span>
            </div>

            <!-- EMAIL -->
            <div class="mb-3">
                <label class="text-white mb-2">
                    Email (Optional)
                </label>
                <input asp-for="Email"
                       type="email"
                       class="form-control bg-dark text-white border-0"
                       placeholder="e.g. karachi@symphony.edu.pk" />
                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <!-- IS ACTIVE -->
            <div class="mb-4">
                <div class="form-check">
                    <input asp-for="IsActive"
                           class="form-check-input"
                           type="checkbox" />
                    <label class="form-check-label text-white">
                        Active — Show on Contact page
                    </label>
                </div>
            </div>

            <!-- BUTTONS -->
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save me-2"></i>Save Branch
                </button>
                <a href="/Admin/Branches" class="btn btn-secondary">
                    Cancel
                </a>
            </div>

        </form>
    </div>