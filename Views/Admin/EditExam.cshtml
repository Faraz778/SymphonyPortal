@model SymphonyPortal.Models.EntranceExam

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- HEADER -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="text-white mb-0">
        <i class="fa fa-edit me-2"></i>Edit Exam
    </h4>
    <a href="/Admin/EntranceExams" class="btn btn-secondary">
        <i class="fa fa-arrow-left me-2"></i>Back
    </a>
</div>

<!-- FORM -->
<div class="bg-secondary rounded p-4">
    <form method="post" asp-action="EditExam" asp-controller="Admin">

        <!-- HIDDEN ID -->
        <input type="hidden" asp-for="Id" />

        <!-- TITLE -->
        <div class="mb-3">
            <label class="text-white mb-2">Exam Title</label>
            <input asp-for="Title"
                   class="form-control bg-dark text-white border-0" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <!-- EXAM DATE -->
        <div class="mb-3">
            <label class="text-white mb-2">Exam Date</label>
            <input asp-for="ExamDate"
                   type="date"
                   class="form-control bg-dark text-white border-0" />
            <span asp-validation-for="ExamDate" class="text-danger"></span>
        </div>

        <!-- LAST DATE TO APPLY -->
        <div class="mb-3">
            <label class="text-white mb-2">Last Date to Apply</label>
            <input asp-for="LastDateToApply"
                   type="date"
                   class="form-control bg-dark text-white border-0" />
            <span asp-validation-for="LastDateToApply" class="text-danger"></span>
        </div>

        <!-- EXAM FEES -->
        <div class="mb-3">
            <label class="text-white mb-2">Exam Fees ($)</label>
            <input asp-for="ExamFees"
                   type="number"
                   class="form-control bg-dark text-white border-0" />
            <span asp-validation-for="ExamFees" class="text-danger"></span>
        </div>

        <!-- DESCRIPTION -->
        <div class="mb-3">
            <label class="text-white mb-2">Description (Optional)</label>
            <textarea asp-for="Description"
                      class="form-control bg-dark text-white border-0"
                          rows="3">
            </textarea>
            </div>

            <!-- IS ACTIVE -->
            <div class="mb-4">
                <div class="form-check">
                    <input asp-for="IsActive"
                           class="form-check-input"
                           type="checkbox" />
                    <label class="form-check-label text-white">
                        Active Exam
                    </label>
                </div>
            </div>

            <!-- BUTTONS -->
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save me-2"></i>Update Exam
                </button>
                <a href="/Admin/EntranceExams" class="btn btn-secondary">
                    Cancel
                </a>
            </div>

        </form>
    </div>