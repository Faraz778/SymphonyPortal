@model List<SymphonyPortal.Models.EntranceExam>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- HEADER -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="text-white mb-0">
        <i class="fa fa-file-alt me-2"></i>Entrance Exams
    </h4>
    <a href="/Admin/CreateExam" class="btn btn-primary">
        <i class="fa fa-plus me-2"></i>Add New Exam
    </a>
</div>

<!-- SUCCESS MESSAGE -->
@if (TempData["success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4">
        <i class="fa fa-check-circle me-2"></i>
        @TempData["success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- TABLE -->
<div class="bg-secondary rounded p-4">
    <div class="table-responsive">
        <table class="table text-start align-middle
            table-bordered table-hover mb-0">
            <thead>
                <tr class="text-white">
                    <th>#</th>
                    <th>Title</th>
                    <th>Exam Date</th>
                    <th>Last Date</th>
                    <th>Fees</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center">
                            No exams added yet
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var exam in Model)
                    {
                        <tr>
                            <td>@exam.Id</td>
                            <td>@exam.Title</td>
                            <td>@exam.ExamDate.ToString("dd MMM yyyy")</td>
                            <td>@exam.LastDateToApply.ToString("dd MMM yyyy")</td>
                            <td>$@exam.ExamFees</td>
                            <td>
                                @if (exam.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td>
                                <a href="/Admin/EditExam/@exam.Id"
                                       class="btn btn-sm btn-primary me-1">
                                    <i class="fa fa-edit"></i> Edit
                                </a>
                                <a href="/Admin/DeleteExam/@exam.Id"
                                       class="btn btn-sm btn-danger"
                                       onclick="return confirm('Are you sure?')">
                                    <i class="fa fa-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>