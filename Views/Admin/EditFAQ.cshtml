@model SymphonyPortal.Models.FAQ

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- HEADER -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="text-white mb-0">
        <i class="fa fa-edit me-2"></i>Edit FAQ
    </h4>
    <a href="/Admin/FAQs" class="btn btn-secondary">
        <i class="fa fa-arrow-left me-2"></i>Back
    </a>
</div>

<div class="bg-secondary rounded p-4">
    <form method="post"
          asp-action="EditFAQ"
          asp-controller="Admin">

        <!-- HIDDEN ID -->
        <input type="hidden" asp-for="Id" />

        <!-- QUESTION -->
        <div class="mb-3">
            <label class="text-white mb-2">Question</label>
            <input asp-for="Question"
                   class="form-control bg-dark text-white border-0" />
            <span asp-validation-for="Question"
                  class="text-danger"></span>
        </div>

        <!-- ANSWER -->
        <div class="mb-3">
            <label class="text-white mb-2">Answer</label>
            <textarea asp-for="Answer"
                      class="form-control bg-dark text-white border-0"
                          rows="4">
            </textarea>
                <span asp-validation-for="Answer"
                      class="text-danger"></span>
            </div>

            <!-- DISPLAY ORDER -->
            <div class="mb-3">
                <label class="text-white mb-2">Display Order</label>
                <input asp-for="DisplayOrder"
                       type="number"
                       class="form-control bg-dark text-white border-0" />
                <small class="text-muted">
                    1 = pehle dikhega, 2 = doosra, aur aise hi
                </small>
            </div>

            <!-- IS ACTIVE -->
            <div class="mb-4">
                <div class="form-check">
                    <input asp-for="IsActive"
                           class="form-check-input"
                           type="checkbox" />
                    <label class="form-check-label text-white">
                        Active — Public website pe dikhega
                    </label>
                </div>
            </div>

            <!-- BUTTONS -->
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save me-2"></i>Update FAQ
                </button>
                <a href="/Admin/FAQs" class="btn btn-secondary">
                    Cancel
                </a>
            </div>

        </form>
    </div>