@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- STATS CARDS -->
<div class="row g-4">

    <div class="col-sm-6 col-xl-3">
        <div class="bg-secondary rounded d-flex align-items-center justify-content-between p-4">
            <i class="fa fa-book fa-3x text-primary"></i>
            <div class="ms-3">
                <p class="mb-2">Total Courses</p>
                <h6 class="mb-0">@ViewBag.TotalCourses</h6>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="bg-secondary rounded d-flex align-items-center justify-content-between p-4">
            <i class="fa fa-users fa-3x text-primary"></i>
            <div class="ms-3">
                <p class="mb-2">Total Students</p>
                <h6 class="mb-0">@ViewBag.TotalStudents</h6>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="bg-secondary rounded d-flex align-items-center justify-content-between p-4">
            <i class="fa fa-file-alt fa-3x text-primary"></i>
            <div class="ms-3">
                <p class="mb-2">Total Exams</p>
                <h6 class="mb-0">@ViewBag.TotalExams</h6>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="bg-secondary rounded d-flex align-items-center justify-content-between p-4">
            <i class="fa fa-map-marker-alt fa-3x text-primary"></i>
            <div class="ms-3">
                <p class="mb-2">Total Branches</p>
                <h6 class="mb-0">@ViewBag.TotalBranches</h6>
            </div>
        </div>
    </div>

</div>

<!-- RECENT STUDENTS TABLE -->
<div class="row g-4 mt-2">
    <div class="col-12">
        <div class="bg-secondary rounded p-4">

            <div class="d-flex align-items-center justify-content-between mb-4">
                <h6 class="mb-0">Recent Students</h6>
                <a href="/Admin/Students" class="text-primary">Show All</a>
            </div>

            <div class="table-responsive">
                <table class="table text-start align-middle table-bordered table-hover mb-0">
                    <thead>
                        <tr class="text-white">
                            <th>#</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.RecentStudents != null)
                        {
                            @foreach (var s in ViewBag.RecentStudents)
                            {
                                <tr>
                                    <td>@s.Id</td>
                                    <td>@s.Name</td>
                                    <td>@s.Email</td>
                                    <td>@s.Phone</td>
                                    <td>
                                        <span class="badge
                                            @(s.Status == "Accepted" ? "bg-success" :
                                                                        s.Status == "Rejected" ? "bg-danger" :
                                                                        "bg-warning")">
                                            @s.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center">
                                    No students yet
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>
