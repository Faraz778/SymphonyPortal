@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- HEADER -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="text-white mb-0">
        <i class="fa fa-plus me-2"></i>Add Result
    </h4>
    <a href="/Admin/ExamResults" class="btn btn-secondary">
        <i class="fa fa-arrow-left me-2"></i>Back
    </a>
</div>

<div class="bg-secondary rounded p-4">
    <form method="post"
          asp-action="CreateResult"
          asp-controller="Admin">

        <!-- STUDENT -->
        <div class="mb-3">
            <label class="text-white mb-2">Student</label>
            <select name="StudentId"
                    class="form-control bg-dark text-white border-0"
                    required>
                <option value="">-- Select Accepted Student --</option>
                @foreach (var student in ViewBag.Students)
                {
                    <option value="@student.Id">
                        @student.Name — @student.RollNumber
                    </option>
                }
            </select>
            <small class="text-muted">
                Only accepted students are shown
            </small>
        </div>

        <!-- ROLL NUMBER -->
        <div class="mb-3">
            <label class="text-white mb-2">Roll Number</label>
            <input name="RollNumber"
                   class="form-control bg-dark text-white border-0"
                   placeholder="e.g. SYM-2025-0001"
                   required />
        </div>

        <!-- MARKS -->
        <div class="mb-3">
            <label class="text-white mb-2">
                Marks Obtained (out of 100)
            </label>
            <input name="MarksObtained"
                   type="number"
                   min="0"
                   max="100"
                   class="form-control bg-dark text-white border-0"
                   placeholder="Enter marks"
                   required />
            <small class="text-muted">
                50+ = Advanced Class ($4275) |
                Below 50 = Basic Class ($6000)
            </small>
        </div>

        <!-- LAST DATE FOR PAYMENT -->
        <div class="mb-3">
            <label class="text-white mb-2">
                Last Date for Payment
            </label>
            <input name="LastDateForPayment"
                   type="date"
                   class="form-control bg-dark text-white border-0"
                   required />
        </div>

        <!-- FEEDBACK -->
        <div class="mb-4">
            <label class="text-white mb-2">
                Feedback (Optional)
            </label>
            <textarea name="Feedback"
                  class="form-control bg-dark text-white border-0"
                  rows="3"
                      placeholder="Faculty feedback after course completion">
            </textarea>
        </div>

        <!-- BUTTONS -->
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="fa fa-save me-2"></i>Save Result
            </button>
            <a href="/Admin/ExamResults" class="btn btn-secondary">
                Cancel
            </a>
        </div>

    </form>
</div>