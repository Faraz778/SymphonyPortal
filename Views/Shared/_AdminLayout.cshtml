<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>Symphony Admin</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Roboto:wght@500;700&display=swap"
          rel="stylesheet">

    <!-- Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Owl Carousel CSS -->
    <link href="~/admin/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

        <!-- Theme CSS -->
        <link href="~/admin/css/bootstrap.min.css" rel="stylesheet">
            <link href="~/admin/css/style.css" rel="stylesheet">
            </head>

            <body>
                <div class="container-fluid position-relative d-flex p-0">

                    <!-- Spinner -->
                    <div id="spinner"
                         class="show bg-dark position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
                        <div class="spinner-border text-primary" style="width:3rem;height:3rem;" role="status">
                            <span class="sr-only">Loading...</span>
                        </div>
                    </div>

                    <!-- SIDEBAR -->
                    <div class="sidebar pe-4 pb-3">
                        <nav class="navbar bg-secondary navbar-dark">

                            <!-- LOGO -->
                            <a href="/Admin/Dashboard" class="navbar-brand mx-4 mb-3">
                                <h3 class="text-primary">
                                    <i class="fa fa-graduation-cap me-2"></i>Symphony
                                </h3>
                            </a>

                            <!-- ADMIN INFO -->
                            <div class="d-flex align-items-center ms-4 mb-4">
                                <div class="position-relative">
                                    <img class="rounded-circle"
                                         src="~/admin/img/user.jpg"
                                         style="width:40px;height:40px;" alt="">
                                        <div class="bg-success rounded-circle border border-2 border-white position-absolute end-0 bottom-0 p-1"></div>
                                    </div>
                                    <div class="ms-3">
                                        <h6 class="mb-0">@Context.Session.GetString("AdminName")</h6>
                                        <span>Admin</span>
                                    </div>
                                </div>

                                <!-- MENU -->
                                <div class="navbar-nav w-100">

                                    <a href="/Admin/Dashboard"
                                           class="nav-item nav-link @(Context.Request.Path == "/Admin/Dashboard" ? "active" : "")">
                                        <i class="fa fa-tachometer-alt me-2"></i>Dashboard
                                    </a>

                                    <a href="/Admin/Courses"
                                           class="nav-item nav-link @(Context.Request.Path.StartsWithSegments("/Admin/Courses") ? "active" : "")">
                                        <i class="fa fa-book me-2"></i>Courses
                                    </a>

                                    <a href="/Admin/EntranceExams"
                                           class="nav-item nav-link @(Context.Request.Path.StartsWithSegments("/Admin/EntranceExams") ? "active" : "")">
                                        <i class="fa fa-file-alt me-2"></i>Entrance Exams
                                    </a>

                                    <a href="/Admin/Students"
                                           class="nav-item nav-link @(Context.Request.Path.StartsWithSegments("/Admin/Students") ? "active" : "")">
                                        <i class="fa fa-users me-2"></i>Students
                                    </a>

                                    <a href="/Admin/ExamResults"
                                           class="nav-item nav-link @(Context.Request.Path.StartsWithSegments("/Admin/ExamResults") ? "active" : "")">
                                        <i class="fa fa-poll me-2"></i>Exam Results
                                    </a>

                                    <a href="/Admin/FAQs"
                                           class="nav-item nav-link @(Context.Request.Path.StartsWithSegments("/Admin/FAQs") ? "active" : "")">
                                        <i class="fa fa-question-circle me-2"></i>FAQs
                                    </a>

                                    <a href="/Admin/Branches"
                                           class="nav-item nav-link @(Context.Request.Path.StartsWithSegments("/Admin/Branches") ? "active" : "")">
                                        <i class="fa fa-map-marker-alt me-2"></i>Branches
                                    </a>

                                    <hr class="text-white mx-3">

                                    <a href="/Admin/Logout" class="nav-item nav-link">
                                        <i class="fa fa-sign-out-alt me-2"></i>Logout
                                    </a>

                                </div>
                            </nav>
                        </div>
                        <!-- Sidebar End -->
                        <!-- CONTENT -->
                        <div class="content">

                            <!-- TOP NAVBAR -->
                            <nav class="navbar navbar-expand bg-secondary navbar-dark sticky-top px-4 py-0">

                                <a href="#" class="sidebar-toggler flex-shrink-0">
                                    <i class="fa fa-bars"></i>
                                </a>

                                <div class="navbar-nav align-items-center ms-auto">

                                    <!-- Admin Dropdown -->
                                    <div class="nav-item dropdown">
                                        <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                                            <img class="rounded-circle me-lg-2"
                                                 src="~/admin/img/user.jpg"
                                                 style="width:40px;height:40px;" alt="">
                                                <span class="d-none d-lg-inline-flex">
                                                    @Context.Session.GetString("AdminName")
                                                </span>
                                            </a>
                                            <div class="dropdown-menu dropdown-menu-end bg-secondary border-0 rounded-0 rounded-bottom m-0">
                                                <a href="#" class="dropdown-item"><i class="fa fa-user"></i> My Profile 
                                                    </a>
                                                <a href="#" class="dropdown-item"><i class="fa fa-cogs"></i> Settings
                                                  
                                                </a>
                                                <a href="/Admin/Logout" class="dropdown-item">
                                                    <i class="fa fa-sign-out-alt me-2"></i>Logout
                                                </a>
                                            </div>
                                        </div>

                                    </div>
                                </nav>
                                <!-- Navbar End -->
                                <!-- PAGE CONTENT -->
                                <div class="container-fluid pt-4 px-4">
                                    @RenderBody()
                                </div>

                                <!-- FOOTER -->
                                <div class="container-fluid pt-4 px-4">
                                    <div class="bg-secondary rounded-top p-4">
                                        <div class="col-12 text-center">
                                            &copy; Symphony Limited Admin Panel
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <!-- Content End -->
                            <!-- Back to Top -->
                            <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top">
                                <i class="bi bi-arrow-up"></i>
                            </a>

                        </div>

                        <!-- JavaScript -->
                        <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
                        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
                        <script src="~/admin/lib/chart/chart.min.js"></script>
                        <script src="~/admin/lib/easing/easing.min.js"></script>
                        <script src="~/admin/lib/waypoints/waypoints.min.js"></script>
                        <script src="~/admin/lib/owlcarousel/owl.carousel.min.js"></script>
                        <script src="~/admin/js/main.js"></script>

                    </body>
                </html>