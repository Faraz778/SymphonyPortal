<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Symphony Institute</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
        <!-- Font Awesome -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css">

        <!-- Custom CSS -->
        <style>
                :root {
                    --primary: #e63946;
                    --dark: #1d1d2e;
                    --darker: #13131f;
                }

                body {
                    background-color: var(--darker);
                    color: #fff;
                    font-family: 'Segoe UI', sans-serif;
                }

                /* NAVBAR */
                .navbar-custom {
                    background-color: var(--dark);
                    border-bottom: 2px solid var(--primary);
                    padding: 15px 0;
                }

                    .navbar-custom .navbar-brand {
                        font-size: 24px;
                        font-weight: 700;
                        color: var(--primary) !important;
                    }

                    .navbar-custom .nav-link {
                        color: #fff !important;
                        font-weight: 500;
                        margin: 0 8px;
                        transition: color 0.3s;
                    }

                        .navbar-custom .nav-link:hover,
                        .navbar-custom .nav-link.active {
                            color: var(--primary) !important;
                        }

                .navbar-toggler {
                    border-color: var(--primary);
                }

                .navbar-toggler-icon {
                    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28230, 57, 70, 1%29' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
                }

                /* BUTTONS */
                .btn-primary {
                    background-color: var(--primary);
                    border-color: var(--primary);
                }

                    .btn-primary:hover {
                        background-color: #c1121f;
                        border-color: #c1121f;
                    }

                .btn-outline-primary {
                    color: var(--primary);
                    border-color: var(--primary);
                }

                    .btn-outline-primary:hover {
                        background-color: var(--primary);
                        color: #fff;
                    }

                /* CARDS */
                .card-custom {
                    background-color: var(--dark);
                    border: 1px solid #2a2a3e;
                    border-radius: 10px;
                    transition: transform 0.3s, border-color 0.3s;
                }

                    .card-custom:hover {
                        transform: translateY(-5px);
                        border-color: var(--primary);
                    }

                /* SECTION */
                .section-title {
                    font-size: 32px;
                    font-weight: 700;
                    color: #fff;
                    margin-bottom: 10px;
                }

                    .section-title span {
                        color: var(--primary);
                    }

                .section-divider {
                    width: 60px;
                    height: 3px;
                    background: var(--primary);
                    margin: 0 auto 40px;
                }

                /* HERO */
                .hero-section {
                    background: linear-gradient(135deg, var(--darker) 0%, var(--dark) 100%);
                    padding: 100px 0;
                    border-bottom: 2px solid var(--primary);
                }

                    .hero-section h1 {
                        font-size: 48px;
                        font-weight: 700;
                        line-height: 1.3;
                    }

                        .hero-section h1 span {
                            color: var(--primary);
                        }

                /* FOOTER */
                .footer-custom {
                    background-color: var(--dark);
                    border-top: 2px solid var(--primary);
                    padding: 40px 0 20px;
                }

                    .footer-custom h5 {
                        color: var(--primary);
                        font-weight: 600;
                        margin-bottom: 15px;
                    }

                    .footer-custom p,
                    .footer-custom a {
                        color: #aaa;
                        text-decoration: none;
                        font-size: 14px;
                    }

                        .footer-custom a:hover {
                            color: var(--primary);
                        }

                .footer-bottom {
                    border-top: 1px solid #2a2a3e;
                    margin-top: 30px;
                    padding-top: 20px;
                    color: #666;
                    font-size: 13px;
                }

                /* BADGE */
                .badge-primary {
                    background-color: var(--primary);
                    color: #fff;
                    padding: 5px 12px;
                    border-radius: 20px;
                    font-size: 12px;
                }

                /* TABLE */
                .table-dark-custom {
                    background-color: var(--dark);
                    color: #fff;
                }

                    .table-dark-custom th {
                        background-color: var(--primary);
                        color: #fff;
                        border: none;
                    }

                    .table-dark-custom td {
                        border-color: #2a2a3e;
                    }

                /* FORM */
                .form-control-dark {
                    background-color: var(--dark);
                    border: 1px solid #2a2a3e;
                    color: #fff;
                    border-radius: 8px;
                }

                    .form-control-dark:focus {
                        background-color: var(--dark);
                        border-color: var(--primary);
                        color: #fff;
                        box-shadow: 0 0 0 0.2rem rgba(230,57,70,0.25);
                    }

                /* ALERT */
                .alert-custom {
                    background-color: var(--dark);
                    border: 1px solid var(--primary);
                    color: #fff;
                    border-radius: 8px;
                }
        </style>

    </head>
    <body>

        <!-- NAVBAR -->
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">

                <!-- LOGO -->
                <a class="navbar-brand" href="/">
                    <i class="fa fa-graduation-cap me-2"></i>Symphony
                </a>

                <!-- TOGGLE -->
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- MENU -->
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link @(Context.Request.Path == "/" ? "active" : "")"
                                   href="/">
                                <i class="fa fa-home me-1"></i>Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Context.Request.Path == "/Home/Courses" ? "active" : "")"
                                   href="/Home/Courses">
                                <i class="fa fa-book me-1"></i>Courses
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Context.Request.Path == "/Home/Exams" ? "active" : "")"
                                   href="/Home/Exams">
                                <i class="fa fa-file-alt me-1"></i>Exams
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Context.Request.Path == "/Home/Results" ? "active" : "")"
                                   href="/Home/Results">
                                <i class="fa fa-poll me-1"></i>Results
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Context.Request.Path == "/Home/FAQ" ? "active" : "")"
                                   href="/Home/FAQ">
                                <i class="fa fa-question-circle me-1"></i>FAQ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Context.Request.Path == "/Home/Contact" ? "active" : "")"
                                   href="/Home/Contact">
                                <i class="fa fa-map-marker-alt me-1"></i>Contact
                            </a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="btn btn-primary px-3"
                                   href="/Home/Apply">
                                Apply Now
                            </a>
                        </li>

                        <li class="nav-item ms-2">
                            <a class="btn btn-outline-primary px-3"
                                   href="/Admin/Login">
                                <i class="fa fa-lock me-1"></i>Admin
                            </a>
                        </li>

                    </ul>
                </div>

            </div>
        </nav>

        <!-- PAGE CONTENT -->
        <main>
            @RenderBody()
        </main>

        <!-- FOOTER -->
        <footer class="footer-custom mt-5">
            <div class="container">
                <div class="row">

                    <!-- ABOUT -->
                    <div class="col-md-4 mb-4">
                        <h5><i class="fa fa-graduation-cap me-2"></i>Symphony</h5>
                        <p>
                            Symphony Limited is a leading IT training institute
                            offering world-class courses in programming,
                            databases, and modern technologies.
                        </p>
                    </div>

                    <!-- QUICK LINKS -->
                    <div class="col-md-3 mb-4">
                        <h5>Quick Links</h5>
                        <ul class="list-unstyled">
                            <li><a href="/"><i class="fa fa-chevron-right me-1"></i>Home</a></li>
                            <li><a href="/Home/Courses"><i class="fa fa-chevron-right me-1"></i>Courses</a></li>
                            <li><a href="/Home/Exams"><i class="fa fa-chevron-right me-1"></i>Exams</a></li>
                            <li><a href="/Home/Results"><i class="fa fa-chevron-right me-1"></i>Results</a></li>
                            <li><a href="/Home/FAQ"><i class="fa fa-chevron-right me-1"></i>FAQ</a></li>
                            <li><a href="/Home/Contact"><i class="fa fa-chevron-right me-1"></i>Contact</a></li>
                        </ul>
                    </div>

                    <!-- CONTACT -->
                    <div class="col-md-5 mb-4">
                        <h5>Contact Us</h5>
                        <p><i class="fa fa-map-marker-alt me-2 text-danger"></i>Main Branch, Karachi, Pakistan</p>
                        <p><i class="fa fa-phone me-2 text-danger"></i>+92-21-XXXXXXXX</p>
                        <p><i class="fa fa-envelope me-2 text-danger"></i>info@symphony.edu.pk</p>
                    </div>

                </div>

                <!-- FOOTER BOTTOM -->
                <div class="footer-bottom text-center">
                    <p>&copy; 2025 Symphony Limited. All Rights Reserved.</p>
                </div>
            </div>
        </footer>

        <!-- Bootstrap JS -->
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/lib/jquery/dist/jquery.min.js"></script>

    </body>
</html>