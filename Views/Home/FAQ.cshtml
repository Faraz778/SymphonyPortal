@model List<SymphonyPortal.Models.FAQ>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- PAGE HEADER -->
<section style="background:#1d1d2e; padding:60px 0;
    border-bottom:2px solid #e63946;">
    <div class="container text-center">
        <h1 class="section-title">
            Frequently Asked <span>Questions</span>
        </h1>
        <p style="color:#aaa; font-size:16px;">
            Find answers to common questions about
            Symphony Institute.
        </p>
    </div>
</section>

<!-- FAQ LIST -->
<section style="padding:80px 0;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                @if (Model.Count == 0)
                {
                    <div class="text-center">
                        <i class="fa fa-question-circle fa-4x mb-3"
                           style="color:#e63946; opacity:0.5;"></i>
                        <p style="color:#aaa; font-size:18px;">
                            No FAQs available at the moment.
                        </p>
                    </div>
                }
                else
                {
                    <!-- ACCORDION -->
                    <div class="accordion" id="faqAccordion">
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <div class="accordion-item mb-3"
                                 style="background:#1d1d2e;
                                border:1px solid #2a2a3e;
                                border-radius:10px;
                                overflow:hidden;">

                                <!-- QUESTION -->
                                <h2 class="accordion-header">
                                    <button class="accordion-button
                                        @(i == 0 ? "" : "collapsed")"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#faq@(i)"
                                            style="background:#1d1d2e;
                                        color:#fff;
                                        font-weight:500;
                                        border:none;
                                        box-shadow:none;">
                                        <i class="fa fa-question-circle me-2"
                                           style="color:#e63946;"></i>
                                        @Model[i].Question
                                    </button>
                                </h2>

                                <!-- ANSWER -->
                                <div id="faq@(i)"
                                     class="accordion-collapse collapse
                                    @(i == 0 ? "show" : "")"
                                     data-bs-parent="#faqAccordion">
                                    <div class="accordion-body"
                                         style="background:#13131f;
                                        color:#aaa;
                                        border-top:1px solid #2a2a3e;">
                                        <i class="fa fa-check-circle me-2"
                                           style="color:#e63946;"></i>
                                        @Model[i].Answer
                                    </div>
                                </div>

                            </div>
                        }
                    </div>
                }

            </div>
        </div>

        <!-- STILL HAVE QUESTIONS -->
        <div class="row justify-content-center mt-5">
            <div class="col-lg-8">
                <div class="card-custom p-4 text-center">
                    <i class="fa fa-headset fa-3x mb-3"
                       style="color:#e63946;"></i>
                    <h5 style="color:#fff;">
                        Still have questions?
                    </h5>
                    <p style="color:#aaa;">
                        Contact us and our team will
                        answer all your queries.
                    </p>
                    <a href="/Home/Contact"
                           class="btn btn-primary px-4">
                        <i class="fa fa-phone me-2"></i>
                        Contact Us
                    </a>
                </div>
            </div>
        </div>

    </div>
</section>