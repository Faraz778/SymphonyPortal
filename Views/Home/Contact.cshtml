@model List<SymphonyPortal.Models.Branch>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- PAGE HEADER -->
<section style="background:#1d1d2e; padding:60px 0;
    border-bottom:2px solid #e63946;">
    <div class="container text-center">
        <h1 class="section-title">
            Contact <span>Us</span>
        </h1>
        <p style="color:#aaa; font-size:16px;">
            Visit any of our branches or get in touch with us.
        </p>
    </div>
</section>

<!-- BRANCHES SECTION -->
<section style="padding:80px 0;">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="section-title">
                Our <span>Branches</span>
            </h2>
            <div class="section-divider"></div>
        </div>

        @if (Model.Count == 0)
        {
            <div class="text-center">
                <i class="fa fa-map-marker-alt fa-4x mb-3"
                   style="color:#e63946; opacity:0.5;"></i>
                <p style="color:#aaa; font-size:18px;">
                    No branches available at the moment.
                </p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var branch in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card-custom p-4 h-100">

                            <!-- ICON -->
                            <div class="mb-3">
                                <span style="background:#e63946;
                                    border-radius:10px;
                                    padding:12px 16px;">
                                    <i class="fa fa-map-marker-alt"
                                       style="color:#fff;
                                    font-size:22px;"></i>
                                </span>
                            </div>

                            <!-- NAME -->
                            <h5 style="color:#fff; font-weight:600;">
                                @branch.Name
                            </h5>

                            <hr style="border-color:#2a2a3e;">

                            <!-- ADDRESS -->
                            <div class="d-flex mb-2">
                                <i class="fa fa-map-marker-alt mt-1 me-2"
                                   style="color:#e63946; min-width:16px;"></i>
                                <p style="color:#aaa; margin:0;
                                    font-size:14px;">
                                    @branch.Address
                                </p>
                            </div>

                            <!-- CITY -->
                            @if (!string.IsNullOrEmpty(branch.City))
                            {
                                <div class="d-flex mb-2">
                                    <i class="fa fa-city mt-1 me-2"
                                       style="color:#e63946;
                                    min-width:16px;"></i>
                                    <p style="color:#aaa; margin:0;
                                        font-size:14px;">
                                        @branch.City
                                    </p>
                                </div>
                            }

                            <!-- PHONE -->
                            <div class="d-flex mb-2">
                                <i class="fa fa-phone mt-1 me-2"
                                   style="color:#e63946; min-width:16px;"></i>
                                <a href="tel:@branch.Phone"
                                       style="color:#aaa; font-size:14px;
                                    text-decoration:none;">
                                    @branch.Phone
                                </a>
                            </div>

                            <!-- EMAIL -->
                            @if (!string.IsNullOrEmpty(branch.Email))
                            {
                                <div class="d-flex">
                                    <i class="fa fa-envelope mt-1 me-2"
                                       style="color:#e63946;
                                    min-width:16px;"></i>
                                    <a href="mailto:@branch.Email"
                                           style="color:#aaa; font-size:14px;
                                        text-decoration:none;">
                                        @branch.Email
                                    </a>
                                </div>
                            }

                        </div>
                    </div>
                }
            </div>
        }

    </div>
</section>


<!-- CONTACT INFO SECTION -->
<section style="background:#1d1d2e; padding:80px 0;
                border-top:1px solid #2a2a3e;">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="section-title">
                Get In <span>Touch</span>
            </h2>
            <div class="section-divider"></div>
        </div>

        <div class="row g-4 text-center">

            <!-- PHONE -->
            <div class="col-md-4">
                <div class="card-custom p-4">
                    <i class="fa fa-phone fa-3x mb-3"
                       style="color:#e63946;"></i>
                    <h6 style="color:#fff;">Call Us</h6>
                    <p style="color:#aaa; font-size:14px; margin:0;">
                        +92-21-XXXXXXXX
                    </p>
                    <p style="color:#aaa; font-size:14px; margin:0;">
                        Mon - Sat: 9am to 6pm
                    </p>
                </div>
            </div>

            <!-- EMAIL -->
            <div class="col-md-4">
                <div class="card-custom p-4">
                    <i class="fa fa-envelope fa-3x mb-3"
                       style="color:#e63946;"></i>
                    <h6 style="color:#fff;">Email Us</h6>
                    <p style="color:#aaa; font-size:14px; margin:0;">
                        info@symphony.edu.pk
                    </p>
                    <p style="color:#aaa; font-size:14px; margin:0;">
                        We reply within 24 hours
                    </p>
                </div>
            </div>

            <!-- LOCATION -->
            <div class="col-md-4">
                <div class="card-custom p-4">
                    <i class="fa fa-map-marker-alt fa-3x mb-3"
                       style="color:#e63946;"></i>
                    <h6 style="color:#fff;">Visit Us</h6>
                    <p style="color:#aaa; font-size:14px; margin:0;">
                        Main Branch, Karachi
                    </p>
                    <p style="color:#aaa; font-size:14px; margin:0;">
                        Pakistan
                    </p>
                </div>
            </div>

        </div>

    </div>
</section>

<!-- APPLY CTA -->
<section style="background:linear-gradient(135deg,#e63946,#c1121f);
                padding:60px 0;">
    <div class="container text-center">
        <h2 style="color:#fff; font-weight:700;">
            Ready to Join Symphony?
        </h2>
        <p style="color:rgba(255,255,255,0.85);
                  margin:15px 0 25px;">
            Apply now and start your IT career journey with us.
        </p>
        <a href="/Home/Apply"
           class="btn btn-light btn-lg px-5"
           style="color:#e63946; font-weight:600;">
            <i class="fa fa-user-plus me-2"></i>Apply Now
        </a>
    </div>
</section>



