@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- PAGE HEADER -->
<section style="background:#1d1d2e; padding:60px 0;
    border-bottom:2px solid #e63946;">
    <div class="container text-center">
        <h1 class="section-title">
            About <span>Symphony</span>
        </h1>
        <p style="color:#aaa; font-size:16px;">
            Learn more about Symphony Limited and our mission.
        </p>
    </div>
</section>

<!-- ABOUT SECTION -->
<section style="padding:80px 0;">
    <div class="container">
        <div class="row align-items-center g-5">

            <!-- LEFT - ICON -->
            <div class="col-lg-5 text-center">
                <div style="background:linear-gradient(135deg,#e63946,#c1121f);
                    border-radius:20px; padding:60px;
                    display:inline-block;">
                    <i class="fa fa-graduation-cap"
                       style="font-size:100px; color:#fff;"></i>
                </div>
            </div>

            <!-- RIGHT - TEXT -->
            <div class="col-lg-7">
                <h2 class="section-title text-start">
                    Who We <span>Are</span>
                </h2>
                <div style="width:60px; height:3px;
                background:#e63946;
                margin-bottom:25px;"></div>

                <p style="color:#aaa; font-size:15px; line-height:1.9;">
                    Symphony Limited is a leading IT training institute
                    dedicated to providing world-class education in
                    information technology. Established with a vision to
                    bridge the gap between education and industry,
                    we have been training professionals for over a decade.
                </p>
                <p style="color:#aaa; font-size:15px; line-height:1.9;">
                    Our courses are designed by industry experts and
                    cover the latest technologies and tools used in
                    the modern workplace. We offer both basic and
                    advanced programs to cater to students of all
                    skill levels.
                </p>

                <!-- HIGHLIGHTS -->
                <div class="row g-3 mt-2">
                    <div class="col-6">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <i class="fa fa-check-circle fa-lg"
                               style="color:#e63946;"></i>
                            <span style="color:#fff; font-size:14px;">
                                Industry Expert Trainers
                            </span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <i class="fa fa-check-circle fa-lg"
                               style="color:#e63946;"></i>
                            <span style="color:#fff; font-size:14px;">
                                Hands-on Training
                            </span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <i class="fa fa-check-circle fa-lg"
                               style="color:#e63946;"></i>
                            <span style="color:#fff; font-size:14px;">
                                International Certification
                            </span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <i class="fa fa-check-circle fa-lg"
                               style="color:#e63946;"></i>
                            <span style="color:#fff; font-size:14px;">
                                Job Placement Support
                            </span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <i class="fa fa-check-circle fa-lg"
                               style="color:#e63946;"></i>
                            <span style="color:#fff; font-size:14px;">
                                Multiple Branches
                            </span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <i class="fa fa-check-circle fa-lg"
                               style="color:#e63946;"></i>
                            <span style="color:#fff; font-size:14px;">
                                Affordable Fees
                            </span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- MISSION VISION -->
<section style="background:#1d1d2e; padding:80px 0;
    border-top:1px solid #2a2a3e;
    border-bottom:1px solid #2a2a3e;">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="section-title">
                Mission & <span>Vision</span>
            </h2>
            <div class="section-divider"></div>
        </div>

        <div class="row g-4">

            <!-- MISSION -->
            <div class="col-md-6">
                <div class="card-custom p-4 h-100">
                    <div class="mb-3">
                        <span style="background:#e63946;
                            border-radius:10px;
                            padding:12px 16px;">
                            <i class="fa fa-bullseye"
                               style="color:#fff; font-size:22px;"></i>
                        </span>
                    </div>
                    <h5 style="color:#fff; font-weight:600;">Our Mission</h5>
                    <p style="color:#aaa; font-size:14px; line-height:1.8;">
                        To provide high-quality, affordable IT education
                        that empowers individuals to build successful
                        careers in technology. We are committed to
                        delivering practical, industry-relevant training
                        that prepares students for real-world challenges.
                    </p>
                </div>
            </div>

            <!-- VISION -->
            <div class="col-md-6">
                <div class="card-custom p-4 h-100">
                    <div class="mb-3">
                        <span style="background:#e63946;
                            border-radius:10px;
                            padding:12px 16px;">
                            <i class="fa fa-eye"
                               style="color:#fff; font-size:22px;"></i>
                        </span>
                    </div>
                    <h5 style="color:#fff; font-weight:600;">Our Vision</h5>
                    <p style="color:#aaa; font-size:14px; line-height:1.8;">
                        To become the leading IT training institute in
                        Pakistan, recognized for excellence in education,
                        innovation in teaching methods, and producing
                        skilled IT professionals who contribute to the
                        growth of the technology sector.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

