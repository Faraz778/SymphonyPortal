@model List<SymphonyPortal.Models.EntranceExam>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- PAGE HEADER -->
<section style="background:#1d1d2e; padding:60px 0;
    border-bottom:2px solid #e63946;">
    <div class="container text-center">
        <h1 class="section-title">
            Entrance <span>Exams</span>
        </h1>
        <p style="color:#aaa; font-size:16px;">
            Check upcoming entrance exams and apply before the last date.
        </p>
    </div>
</section>

<!-- EXAMS LIST -->
<section style="padding:80px 0;">
    <div class="container">

        @if (Model.Count == 0)
        {
            <div class="text-center">
                <i class="fa fa-file-alt fa-4x mb-3"
                   style="color:#e63946; opacity:0.5;"></i>
                <p style="color:#aaa; font-size:18px;">
                    No upcoming exams at the moment.
                </p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var exam in Model)
                {
                    <div class="col-md-6">
                        <div class="card-custom p-4">

                            <!-- TITLE + BADGE -->
                            <div class="d-flex justify-content-between
                                align-items-start mb-3">
                                <h5 style="color:#fff; font-weight:600;">
                                    <i class="fa fa-file-alt me-2"
                                       style="color:#e63946;"></i>
                                    @exam.Title
                                </h5>
                                <span class="badge-primary">Active</span>
                            </div>

                            <!-- DESCRIPTION -->
                            @if (!string.IsNullOrEmpty(exam.Description))
                            {
                                <p style="color:#aaa; font-size:14px;">
                                    @exam.Description
                                </p>
                            }

                            <hr style="border-color:#2a2a3e;">

                            <!-- DATES + FEES -->
                            <div class="row text-center mb-3">
                                <div class="col-4">
                                    <i class="fa fa-calendar mb-1"
                                       style="color:#e63946; font-size:20px;
                                    display:block;"></i>
                                    <small style="color:#aaa;">Exam Date</small>
                                    <p style="color:#fff; font-weight:600;
                                        margin:0; font-size:14px;">
                                        @exam.ExamDate.ToString("dd MMM yyyy")
                                    </p>
                                </div>
                                <div class="col-4">
                                    <i class="fa fa-clock mb-1"
                                       style="color:#e63946; font-size:20px;
                                    display:block;"></i>
                                    <small style="color:#aaa;">Last Date</small>
                                    <p style="color:#fff; font-weight:600;
                                        margin:0; font-size:14px;">
                                        @exam.LastDateToApply.ToString("dd MMM yyyy")
                                    </p>
                                </div>
                                <div class="col-4">
                                    <i class="fa fa-dollar-sign mb-1"
                                       style="color:#e63946; font-size:20px;
                                    display:block;"></i>
                                    <small style="color:#aaa;">Exam Fees</small>
                                    <p style="color:#fff; font-weight:600;
                                        margin:0; font-size:14px;">
                                        $@exam.ExamFees
                                    </p>
                                </div>
                            </div>

                            <!-- APPLY BUTTON -->
                            <a href="/Home/Apply"
                                   class="btn btn-primary w-100">
                                <i class="fa fa-user-plus me-2"></i>
                                Apply For This Exam
                            </a>

                        </div>
                    </div>
                }
            </div>
        }

    </div>
</section>

<!-- HOW TO APPLY -->
<section style="background:#1d1d2e; padding:80px 0;
    border-top:1px solid #2a2a3e;">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="section-title">
                How To <span>Apply</span>
            </h2>
            <div class="section-divider"></div>
        </div>

        <div class="row g-4 text-center">

            <div class="col-md-3">
                <div class="card-custom p-4">
                    <div style="background:#e63946; width:50px; height:50px;
                        border-radius:50%; display:flex;
                        align-items:center; justify-content:center;
                        margin:0 auto 15px;">
                        <span style="color:#fff; font-weight:700;
                        font-size:20px;">1</span>
                    </div>
                    <h6 style="color:#fff;">Choose Exam</h6>
                    <p style="color:#aaa; font-size:13px;">
                        Select the entrance exam you want to appear in.
                    </p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card-custom p-4">
                    <div style="background:#e63946; width:50px; height:50px;
                        border-radius:50%; display:flex;
                        align-items:center; justify-content:center;
                        margin:0 auto 15px;">
                        <span style="color:#fff; font-weight:700;
                        font-size:20px;">2</span>
                    </div>
                    <h6 style="color:#fff;">Fill Form</h6>
                    <p style="color:#aaa; font-size:13px;">
                        Fill the application form with your details.
                    </p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card-custom p-4">
                    <div style="background:#e63946; width:50px; height:50px;
                        border-radius:50%; display:flex;
                        align-items:center; justify-content:center;
                        margin:0 auto 15px;">
                        <span style="color:#fff; font-weight:700;
                        font-size:20px;">3</span>
                    </div>
                    <h6 style="color:#fff;">Pay Fees</h6>
                    <p style="color:#aaa; font-size:13px;">
                        Pay the exam fees via Cash, Cheque, or DD.
                    </p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card-custom p-4">
                    <div style="background:#e63946; width:50px; height:50px;
                        border-radius:50%; display:flex;
                        align-items:center; justify-content:center;
                        margin:0 auto 15px;">
                        <span style="color:#fff; font-weight:700;
                        font-size:20px;">4</span>
                    </div>
                    <h6 style="color:#fff;">Check Result</h6>
                    <p style="color:#aaa; font-size:13px;">
                        Check your result online using your roll number.
                    </p>
                </div>
            </div>

        </div>

        <div class="text-center mt-5">
            <a href="/Home/Apply"
                   class="btn btn-primary btn-lg px-5">
                <i class="fa fa-user-plus me-2"></i>Apply Now
            </a>
        </div>

    </div>
</section>