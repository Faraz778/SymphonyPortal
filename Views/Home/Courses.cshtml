@model List<SymphonyPortal.Models.Course>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- PAGE HEADER -->
<section style="background:#1d1d2e; padding:60px 0;
    border-bottom:2px solid #e63946;">
    <div class="container text-center">
        <h1 class="section-title">
            Our <span>Courses</span>
        </h1>
        <p style="color:#aaa; font-size:16px;">
            Choose from our wide range of IT courses
            designed for beginners and professionals.
        </p>
    </div>
</section>

<!-- COURSES LIST -->
<section style="padding:80px 0;">
    <div class="container">

        @if (Model.Count == 0)
        {
            <div class="text-center">
                <i class="fa fa-book fa-4x mb-3"
                   style="color:#e63946; opacity:0.5;"></i>
                <p style="color:#aaa; font-size:18px;">
                    No courses available at the moment.
                </p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var course in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card-custom p-4 h-100">

                            <!-- ICON -->
                            <div class="mb-3">
                                <span style="background:#e63946;
                                    border-radius:10px;
                                    padding:12px 16px;">
                                    <i class="fa fa-laptop-code"
                                       style="color:#fff; font-size:24px;"></i>
                                </span>
                            </div>

                            <!-- NAME -->
                            <h5 style="color:#fff; font-weight:600;">
                                @course.Name
                            </h5>

                            <!-- TOPICS -->
                            <p style="color:#aaa; font-size:14px;
                                line-height:1.7;">
                                @course.Topics
                            </p>

                            <hr style="border-color:#2a2a3e;">

                            <!-- DURATION + FEES -->
                            <div class="d-flex justify-content-between
                                align-items-center">
                                <span style="color:#aaa; font-size:13px;">
                                    <i class="fa fa-clock me-1"
                                       style="color:#e63946;"></i>
                                    @course.DurationMonths Months
                                </span>
                                <span style="color:#e63946;
                                    font-weight:700;
                                    font-size:18px;">
                                    $@course.Fees
                                </span>
                            </div>

                            <!-- APPLY BUTTON -->
                            <div class="mt-3">
                                <a href="/Home/Apply"
                                       class="btn btn-outline-primary w-100">
                                    <i class="fa fa-user-plus me-2"></i>
                                    Apply Now
                                </a>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }

    </div>
</section>

<!-- CTA -->
<section style="background:#1d1d2e; padding:60px 0;
    border-top:1px solid #2a2a3e;">
    <div class="container text-center">
        <h3 style="color:#fff; font-weight:600;">
            Not sure which course to choose?
        </h3>
        <p style="color:#aaa; margin:15px 0 25px;">
            Contact us and our team will guide you
            to the right course for your goals.
        </p>
        <a href="/Home/Contact"
               class="btn btn-primary btn-lg px-5">
            <i class="fa fa-phone me-2"></i>Contact Us
        </a>
    </div>
</section>